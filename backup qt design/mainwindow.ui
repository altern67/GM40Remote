                   <property name="styleSheet">
                    <string notr="true">QToolButton {
    border: none;
    background-color: transparent;
    /* Dimensions augmentées à 36px */
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    padding: 0px;
    border-image: url(:/img/led-button-blue.png) 0 120 0 0; 
}
QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 18px; /* Moitié de 36px pour un survol rond parfait */
}
QToolButton:checked {
    border-image: url(:/img/led-button-blue.png) 0 0 0 120;
}
</string>
