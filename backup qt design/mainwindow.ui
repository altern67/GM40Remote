  <property name="styleSheet">
   <string notr="true">/* --- STYLE GLOBAL DES CADRES DU RACK --- */
QGroupBox {
    border: 1px solid #168de0;
    border-radius: 5px;
    margin-top: 16px; 
    color: #168de0;
    font-weight: bold;
    
    /* CRUCIAL : On force le composant parent à accepter le 14px pour ses titres */
    font-size: 14px; 
}

/* --- STYLE DES TITRES (REVERB, DELAY...) --- */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 6px;
    font-size: 14px;
    font-weight: bold;
}

/* --- CIBLAGE DES LABELS DU RACK UNIQUEMENT --- */
